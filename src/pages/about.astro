---
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { getEntry, render } from "astro:content";

const entry = (await getEntry("about", "-index")) as CollectionEntry<"about">;
const { Content } = await render(entry);
const { title, meta_title, image, what_i_do } = entry.data;
---

<Base title={title} meta_title={meta_title} image={image}>
  <section class="section">
    <div class="container">
      <div class="row justify-center md:gx-4">
        <div class="md:col-10 lg:col-8 text-center">
          <h1 set:html={markdownify(title)} class="h2 mb-6" />

          <div class="content mb-8 text-base md:text-lg leading-relaxed">
            <Content />
          </div>
          <a href="/contact" class="btn btn-primary text-white py-2"
            >Entrar em Contato</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container">
      <h2 class="page-heading mb-12 h3">{what_i_do.title}</h2>
      <div class="row justify-center gy-4 text-center">
        {
          what_i_do.items.map((item: { title: string; description: string }) => (
            <div class="lg:col-4 md:col-6">
              <h3 class="text-dark font-weight-700 mb-3 h4">{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
